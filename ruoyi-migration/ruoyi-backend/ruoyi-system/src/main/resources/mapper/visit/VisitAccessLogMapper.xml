<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.visit.mapper.VisitAccessLogMapper">

    <resultMap type="com.ruoyi.visit.domain.VisitAccessLog" id="VisitAccessLogResult">
        <id     property="logId"      column="log_id"      />
        <result property="recordId"   column="record_id"   />
        <result property="recordType" column="record_type" />
        <result property="viewerId"   column="viewer_id"   />
        <result property="viewerName" column="viewer_name" />
        <result property="accessTime" column="access_time" />
    </resultMap>

    <insert id="insertAccessLog" parameterType="com.ruoyi.visit.domain.VisitAccessLog" useGeneratedKeys="true" keyProperty="logId">
        insert into visit_access_log(record_id, record_type, viewer_id, viewer_name, access_time)
        values(#{recordId}, #{recordType}, #{viewerId}, #{viewerName}, sysdate())
    </insert>

    <select id="selectAccessLogs" parameterType="Long" resultMap="VisitAccessLogResult">
        select log_id, record_id, record_type, viewer_id, viewer_name, access_time
        from visit_access_log
        where record_id = #{recordId}
        order by access_time desc
    </select>
</mapper>
