<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.visit.mapper.VisitPhotoMapper">

    <resultMap type="com.ruoyi.visit.domain.VisitPhoto" id="VisitPhotoResult">
        <id     property="photoId"    column="photo_id"    />
        <result property="recordId"   column="record_id"   />
        <result property="filePath"   column="file_path"   />
        <result property="createTime" column="create_time" />
    </resultMap>

    <select id="selectPhotosByRecordId" parameterType="Long" resultMap="VisitPhotoResult">
        select photo_id, record_id, file_path, create_time
        from visit_photo
        where record_id = #{recordId}
        order by photo_id asc
    </select>

    <insert id="insertPhoto" parameterType="com.ruoyi.visit.domain.VisitPhoto" useGeneratedKeys="true" keyProperty="photoId">
        insert into visit_photo(record_id, file_path, create_time)
        values(#{recordId}, #{filePath}, sysdate())
    </insert>

</mapper>
