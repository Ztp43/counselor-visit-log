<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.visit.mapper.VisitOrgMapper">

    <resultMap type="com.ruoyi.visit.domain.VisitCounselor" id="VisitCounselorResult">
        <id     property="id"       column="id"       />
        <result property="name"     column="name"     />
        <result property="username" column="username" />
        <result property="deptId"   column="dept_id"  />
    </resultMap>

    <resultMap type="com.ruoyi.visit.domain.VisitCollege" id="VisitCollegeResult">
        <id     property="collegeId"   column="dept_id"   />
        <result property="collegeName" column="dept_name" />
    </resultMap>

    <!-- 所有辅导员（role_key='counselor'） -->
    <select id="selectCounselorUsers" resultMap="VisitCounselorResult">
        select distinct u.user_id as id, u.nick_name as name, u.user_name as username,
               u.dept_id as dept_id
        from sys_user u
        join sys_user_role ur on u.user_id = ur.user_id
        join sys_role r on r.role_id = ur.role_id
        where r.role_key = 'counselor'
          and u.del_flag = '0'
          and u.status = '0'
        order by u.user_id asc
    </select>

    <!-- 21 个学院（parent_id=200 的部门） -->
    <select id="selectColleges" resultMap="VisitCollegeResult">
        select dept_id, dept_name
        from sys_dept
        where parent_id = 200
          and del_flag = '0'
          and status = '0'
        order by order_num asc, dept_id asc
    </select>

</mapper>
