<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.visit.mapper.VisitItemMapper">

    <resultMap type="com.ruoyi.visit.domain.VisitItem" id="VisitItemResult">
        <id     property="itemId"       column="item_id"       />
        <result property="itemNo"       column="item_no"       />
        <result property="title"        column="title"         />
        <result property="category"     column="category"      />
        <result property="studentName"  column="student_name"  />
        <result property="description"  column="description"   />
        <result property="status"       column="status"        />
        <result property="assigneeId"   column="assignee_id"   />
        <result property="dueDate"      column="due_date"      />
        <result property="deptId"       column="dept_id"       />
        <result property="userId"       column="user_id"       />
        <result property="deletedAt"    column="deleted_at"    />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="assigneeName" column="assignee_name" />
    </resultMap>

    <sql id="selectVisitItemVo">
        select i.item_id, i.item_no, i.title, i.category, i.student_name, i.description,
               i.status, i.assignee_id, i.due_date, i.dept_id, i.user_id, i.deleted_at,
               i.create_by, i.create_time, i.update_by, i.update_time,
               u.nick_name as assignee_name
        from visit_item i
        left join sys_user u on i.assignee_id = u.user_id
    </sql>

    <!-- 条件分页查询：${params.dataScope} 由 @DataScope 注入，实现四级数据权限 -->
    <select id="selectVisitItemList" parameterType="com.ruoyi.visit.domain.VisitItem" resultMap="VisitItemResult">
        <include refid="selectVisitItemVo"/>
        <where>
            i.deleted_at is null
            <if test="itemNo != null and itemNo != ''"> AND i.item_no = #{itemNo}</if>
            <if test="title != null and title != ''"> AND i.title like concat('%', #{title}, '%')</if>
            <if test="category != null and category != ''"> AND i.category = #{category}</if>
            <if test="studentName != null and studentName != ''"> AND i.student_name like concat('%', #{studentName}, '%')</if>
            <if test="status != null and status != ''"> AND i.status = #{status}</if>
            <if test="assigneeId != null and assigneeId != 0"> AND i.assignee_id = #{assigneeId}</if>
            ${params.dataScope}
        </where>
        order by i.item_no desc
    </select>

    <select id="selectVisitItemById" parameterType="Long" resultMap="VisitItemResult">
        <include refid="selectVisitItemVo"/>
        where i.item_id = #{itemId}
    </select>

    <select id="selectMaxSeqOfYear" parameterType="String" resultType="Integer">
        select max(cast(substring(item_no, length(#{yearPrefix}) + 1) as unsigned))
        from visit_item
        where item_no like concat(#{yearPrefix}, '%') and deleted_at is null
    </select>

    <insert id="insertVisitItem" parameterType="com.ruoyi.visit.domain.VisitItem" useGeneratedKeys="true" keyProperty="itemId">
        insert into visit_item(
            <if test="itemNo != null">item_no,</if>
            <if test="title != null">title,</if>
            <if test="category != null">category,</if>
            <if test="studentName != null">student_name,</if>
            <if test="description != null">description,</if>
            <if test="status != null">status,</if>
            <if test="assigneeId != null">assignee_id,</if>
            <if test="dueDate != null">due_date,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="createBy != null">create_by,</if>
            create_time
        ) values(
            <if test="itemNo != null">#{itemNo},</if>
            <if test="title != null">#{title},</if>
            <if test="category != null">#{category},</if>
            <if test="studentName != null">#{studentName},</if>
            <if test="description != null">#{description},</if>
            <if test="status != null">#{status},</if>
            <if test="assigneeId != null">#{assigneeId},</if>
            <if test="dueDate != null">#{dueDate},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateVisitItem" parameterType="com.ruoyi.visit.domain.VisitItem">
        update visit_item
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="category != null">category = #{category},</if>
            <if test="studentName != null">student_name = #{studentName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="assigneeId != null">assignee_id = #{assigneeId},</if>
            <if test="dueDate != null">due_date = #{dueDate},</if>
            update_by = #{updateBy},
            update_time = sysdate()
        </set>
        where item_id = #{itemId}
    </update>

    <update id="softDeleteVisitItem" parameterType="Long">
        update visit_item set deleted_at = sysdate() where item_id = #{itemId}
    </update>
</mapper>
